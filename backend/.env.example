# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_ORIGIN=http://localhost:4000

# Database
DATABASE_URL=postgresql://hayat:hayat@localhost:5432/hayat?schema=public

# JWT
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS provider (swap to Zain/Orange/Umniah gateway in production)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=HAYAT

# Anthropic / AI
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# Rate limits (requests per minute)
THROTTLE_DEFAULT=60
THROTTLE_AUTH=10
THROTTLE_EMERGENCY=20

# Observability
LOG_LEVEL=info

# Demo-only: when true, registering with an email starting with "dr." auto-
# provisions a DOCTOR role, and "hosp." auto-provisions HOSPITAL_ADMIN. This
# is a dev/demo shortcut. MUST be false in production — otherwise anyone can
# claim a clinical or admin role just by picking an email prefix.
ENABLE_DEMO_ROLES=false
