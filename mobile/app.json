{
  "expo": {
    "name": "Hayat",
    "slug": "hayat",
    "scheme": "hayat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hayat.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hayat uses your location to find nearby hospitals and to send it during emergencies.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Hayat uses your location to find nearby hospitals and to send it during emergencies.",
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hayat.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "locales": {
      "ar": "./src/i18n/locales/ar.json",
      "en": "./src/i18n/locales/en.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Hayat uses your location to find nearby hospitals and to send it during emergencies."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
